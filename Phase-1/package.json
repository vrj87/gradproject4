{
  "name": "photos-phase-1",
  "version": "1.0.0",
  "private": true,
  "description": "Phase 1a–1d AI-powered discovery engine for Google Photos vague-memory retrieval",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "1a": "npm run 1a --workspace=@photos/discovery-pipeline",
    "1b": "npm run 1b --workspace=@photos/discovery-pipeline",
    "1c": "npm run 1c --workspace=@photos/discovery-pipeline",
    "1d": "npm run 1d --workspace=@photos/discovery-pipeline",
    "phase1:1a": "npm run 1a",
    "phase1:1b": "npm run 1b",
    "phase1:1c": "npm run 1c",
    "phase1:1d": "npm run 1d",
    "discovery:refresh": "npm run refresh --workspace=@photos/discovery-pipeline",
    "discovery:scrape": "npm run scrape --workspace=@photos/discovery-pipeline",
    "phase2:rank": "npm run rank --prefix ../phase-2",
    "dev": "npm run dev --workspace=@photos/storefront",
    "build": "npm run build --workspace=@photos/storefront",
    "preview": "npm run preview --workspace=@photos/storefront",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
